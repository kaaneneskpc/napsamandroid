<?xml version="1.0" encoding="utf-8"?>
<!--
  Kayıtlar ve tercihler Google hesabına yedeklenmez: Gizlilik ekranı "yalnızca cihazında durur, buluta
  yedeklenmez" der. Android 12+ için android:allowBackup="false" bulut yedeğini zaten kapatır; kurallar
  bunu açıkça da yazar. Yeni telefona bulutsuz, doğrudan aktarım (device-transfer) varsayılan olarak açık
  kalır. Android 11 ve öncesinde allowBackup="false" iki yolu da kapatır.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
